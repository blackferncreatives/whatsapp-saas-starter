# --- Server ---
PORT=3000
APP_BASE_URL=https://your-domain.com

# --- Meta App (created in developers.facebook.com) ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_VERSION=v20.0

# System User token for your Meta Business (long-lived, used server-side
# to send messages on behalf of connected tenant WABAs)
META_SYSTEM_USER_TOKEN=your_system_user_token

# --- Embedded Signup ---
# Configuration ID from Meta App > WhatsApp > Embedded Signup setup
META_CONFIG_ID=your_embedded_signup_config_id

# --- Webhooks ---
# Arbitrary string you choose; must match what you enter in the Meta App
# dashboard's webhook verification field
META_WEBHOOK_VERIFY_TOKEN=choose_a_random_string
# Meta signs payloads with this (same as META_APP_SECRET) to verify authenticity
META_APP_SECRET_FOR_SIGNATURE=your_meta_app_secret

# --- Database ---
# Local/manual setup: point at your own Postgres.
# Using docker-compose: use the service name instead of localhost —
# DATABASE_URL=postgres://whatsapp_saas:whatsapp_saas@postgres:5432/whatsapp_saas
DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_saas

# --- Auth ---
# Use a long, random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Redis (for BullMQ campaign queue) ---
# Using docker-compose: REDIS_URL=redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- Frontend build (docker-compose only) ---
# The public URL your deployed frontend will call — becomes
# VITE_API_BASE_URL baked into the frontend's static build.
PUBLIC_API_BASE_URL=https://api.your-domain.com
